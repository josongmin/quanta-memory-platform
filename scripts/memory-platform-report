#!/usr/bin/env bash
# memory-platform-report — print the workspace member + dependency-direction
# summary the boundary docs refer to.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

echo "quanta-memory-platform — workspace report"
echo
echo "members:"
for manifest in crates/*/Cargo.toml; do
  [ -f "${manifest}" ] || continue
  echo "  - $(basename "$(dirname "${manifest}")")"
done
echo
echo "dependency direction (strict, acyclic):"
echo "  core <- facade <- testkit   (host adapter lives outside this repo)"
echo
echo "verify the split is extractable:"
echo "  scripts/extract-to-standalone-repo.sh --dry-run <dest>"
